<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <Id>80fa81a9-8cc0-4a6f-8136-6dbb3a35229c</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Your Company</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Attaché CSP test" />
  <Description DefaultValue="Diagnostic copy of Attaché used to find a working Content Security Policy. Safe to remove." />
  <IconUrl DefaultValue="https://s7p6ccn77h-lgtm.github.io/outlook-attachment-gallery/assets/icon-64.png?v=13" />
  <HighResolutionIconUrl DefaultValue="https://s7p6ccn77h-lgtm.github.io/outlook-attachment-gallery/assets/icon-128.png?v=13" />
  <SupportUrl DefaultValue="https://github.com/s7p6ccn77h-lgtm/outlook-attachment-gallery" />

  <AppDomains>
    <AppDomain>https://s7p6ccn77h-lgtm.github.io</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1" />
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://s7p6ccn77h-lgtm.github.io/outlook-attachment-gallery/src/taskpane/csp-test.html?v=1" />
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.8">
          <bt:Set Name="Mailbox" />
        </bt:Sets>
      </Requirements>

      <Hosts>
        <Host xsi:type="MailHost">

          <DesktopFormFactor>
            <FunctionFile resid="Commands.Url" />

            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="attacheCspTestGroup">
                  <Label resid="GroupLabel" />
                  <Control xsi:type="Button" id="openCspTestButton">
                    <Label resid="ButtonLabel" />
                    <Supertip>
                      <Title resid="ButtonLabel" />
                      <Description resid="ButtonTooltip" />
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16" />
                      <bt:Image size="32" resid="Icon.32x32" />
                      <bt:Image size="80" resid="Icon.80x80" />
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url" />
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>

          </DesktopFormFactor>
        </Host>
      </Hosts>

      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16x16" DefaultValue="https://s7p6ccn77h-lgtm.github.io/outlook-attachment-gallery/assets/icon-16.png?v=13" />
          <bt:Image id="Icon.32x32" DefaultValue="https://s7p6ccn77h-lgtm.github.io/outlook-attachment-gallery/assets/icon-32.png?v=13" />
          <bt:Image id="Icon.80x80" DefaultValue="https://s7p6ccn77h-lgtm.github.io/outlook-attachment-gallery/assets/icon-80.png?v=13" />
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Commands.Url" DefaultValue="https://s7p6ccn77h-lgtm.github.io/outlook-attachment-gallery/src/taskpane/csp-test.html?v=1" />
          <bt:Url id="Taskpane.Url" DefaultValue="https://s7p6ccn77h-lgtm.github.io/outlook-attachment-gallery/src/taskpane/csp-test.html?v=1" />
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="GroupLabel" DefaultValue="CSP test" />
          <bt:String id="ButtonLabel" DefaultValue="CSP test" />
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="ButtonTooltip" DefaultValue="Open attachments in a searchable, sortable gallery" />
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
